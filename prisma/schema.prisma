// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  VISITOR
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  RESOURCE_SUBMITTED
  RESOURCE_APPROVED
  RESOURCE_REJECTED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String            @id @default(cuid())
  name             String?           @unique
  nickname         String?           // 显示昵称，不等于用户名
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  password         String?           // Credentials provider 使用
  role             UserRole          @default(VISITOR)
  accounts         Account[]
  sessions         Session[]
  guestbookMessages GuestbookMessage[]
  preferences      UserPreference?
  resources        Resource[]
  notifications    Notification[]
  collectibles     UserCollectible[]
  favorites        PostFavorite[]
  postLikes        PostLike[]
  resourceComments ResourceComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserPreference {
  id                String  @id @default(cuid())
  userId            String  @unique
  background        String  @default("clean")
  timePrecision     String  @default("second")
  sidebarCollapsed  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Resource {
  id          String         @id @default(cuid())
  name        String
  summary     String         @default("") // 缩略简介（≤30字，纯文本，卡片用）
  description String         // 详细介绍（≤3000字，MDX，详情页用）
  icon        String?
  homepageUrl String?
  downloadUrl String
  status      ResourceStatus @default(PENDING)
  isOwnerPost Boolean        @default(false) // true = posted by OWNER/ADMIN (pinned + no review)
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags        ResourceTag[]
  comments    ResourceComment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("resources")
}

/** 资源标签（可复用，展示/筛选用） */
model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  resources ResourceTag[]

  @@map("tags")
}

/** 资源-标签 关联 */
model ResourceTag {
  resourceId String
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@map("resource_tags")
}

/** 资源评论区：仅登录用户可发布 */
model ResourceComment {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@map("resource_comments")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model GuestbookMessage {
  id          Int      @id @default(autoincrement())
  author      String
  content     String
  email       String?
  website     String?
  isPublic    Boolean  @default(true)
  isAnonymous Boolean  @default(false)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@map("guestbook_messages")
}

model Danmaku {
  id        Int      @id @default(autoincrement())
  content   String
  color     String   @default("#ffffff")
  speed     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("danmaku")
}

model PageView {
  id        Int      @id @default(autoincrement())
  date      String   @unique // YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("page_views")
}

model UserCollectible {
  id        String   @id @default(cuid())
  userId    String
  itemId    String // banana / bubble-banana / sharing-hero / listener / reader
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_collectibles")
}

/** 每篇 MDX 文章的计数（文章本体是文件，DB 只存统计） */
model PostStats {
  id         Int    @id @default(autoincrement())
  slug       String @unique
  totalViews Int    @default(0)
  monthKey   String @default("") // "YYYY-MM"，跨月自动清零 monthViews
  monthViews Int    @default(0)
  likes      Int    @default(0)
  favorites  Int    @default(0)

  @@map("post_stats")
}

/** 点赞去重：登录用户按账号（userId），匿名访客回退 IP+UA 指纹 */
model PostLike {
  id         Int      @id @default(autoincrement())
  slug       String
  visitorKey String
  userId     String? // 登录用户点赞时记录；同账号换设备/换 IP 仍唯一
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([slug, visitorKey])
  @@unique([userId, slug])
  @@index([slug])
  @@map("post_likes")
}

/** 收藏（登录用户），可增删 */
model PostFavorite {
  id        Int      @id @default(autoincrement())
  slug      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
  @@map("post_favorites")
}

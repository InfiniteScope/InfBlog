# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files
.env
.env*.local
!.env.example

# sqlite database
data/blog.db

# documents & local backups
*.docx
*.doc
*.bak
*.orig
.idea/
# 编辑器本地配置一律不入库（VS Code 扩展会自动写入 settings.json，如 Comment Translate）
.vscode/

# local dev logs & prompt history
/tmp-*
/docs/

# AI tooling config
/.opencode/

# uploaded music assets
/public/music/*
!/public/music/.gitkeep
!/public/music/covers
/public/music/covers/*
!/public/music/covers/.gitkeep

# typescript
*.tsbuildinfo

# locally cached resource icons (server-side regenerated)
/public/uploads/resource-icons/*
!/public/uploads/resource-icons/.gitkeep
